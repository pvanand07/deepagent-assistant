{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deep Agent",
  "version": "0.2.1",
  "identifier": "com.deepagent.app",
  "build": {
    "frontendDist": "../desktop-stub"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Deep Agent",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* https://cdn.jsdelivr.net; img-src 'self' data: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; script-src 'self' https://cdn.jsdelivr.net; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../sidecar/": "sidecar/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "./Entitlements.plist",
      "hardenedRuntime": true
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc5RjE0NjQxMTdDNUJGRjgKUldUNHY4VVhRVWJ4ZVRaYkxYOTNOSnpkWHFiS3NLdHJBRlFwVHVWVmFVMXdvRVVzYUJwQm1CbEEK",
      "endpoints": [
        "https://github.com/pvanand07/deepagent-assistant/releases/latest/download/latest.json"
      ]
    }
  }
}
