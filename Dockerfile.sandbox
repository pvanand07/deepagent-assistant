# Optional custom guest image for the shared Deep Agent microsandbox.
# Default runtime image is python:3.12-slim (no local build required).
#
# Build + load into microsandbox cache:
#   docker build -f Dockerfile.sandbox -t deepagent-workspace:dev .
#   docker save deepagent-workspace:dev | msb load --tag deepagent-workspace:dev
#   set DEEPAGENT_SANDBOX_IMAGE=deepagent-workspace:dev

FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        git \
        ripgrep \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
ENV HOME=/workspace \
    TMPDIR=/tmp \
    LANG=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1

CMD ["bash"]
