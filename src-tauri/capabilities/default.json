{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window — stub chrome then FastAPI loopback UI",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "core:default",
    "core:event:default",
    "opener:default",
    "updater:default",
    "allow-get-app-version",
    "allow-updater-check",
    "allow-updater-install",
    "allow-updater-snooze"
  ]
}
