# Copy this file to .env and fill in your key.

# Required. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional. Any tool-calling-capable model id from https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_TEMPERATURE=0.3
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_SITE_NAME=deep-agent-microsandbox

# Workspace (host path bind-mounted at /workspace in the microVM)
# DEEPAGENT_WORKDIR=./workspace

# App-wide guest network: false → Network.none(), true → Network.public_only()
# DEEPAGENT_NETWORK_ACCESS=false

# Guest image (dev local tag or release registry pin)
# DEEPAGENT_SANDBOX_IMAGE=deepagent-workspace:dev

# DEEPAGENT_SANDBOX_MEMORY=1024
# DEEPAGENT_SANDBOX_CPUS=2
# DEEPAGENT_SANDBOX_IDLE_TIMEOUT=300
# DEEPAGENT_SANDBOX_LOCK_WAIT=120
# DEEPAGENT_EXEC_TIMEOUT=120

# MCP servers (optional). Copy .mcp.json.example to .mcp.json, or set env vars.
# DEEPAGENT_MCP_ENABLED=true
# IRESEARCHER_MCP_URL=https://iresearcher-mcp.elevatics.site/mcp
# IRESEARCHER_MCP_BEARER_TOKEN=your_token_here
