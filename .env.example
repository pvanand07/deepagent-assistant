# Copy this file to .env and fill in your key.
# Optional: create .env.local for machine-specific overrides (loaded after .env).
# Browser/dev: both are read from the repo root regardless of process cwd.
# Desktop (DEEPAGENT_DESKTOP=1 / DEEPAGENT_DATA_DIR): load from AppData
#   %APPDATA%\DeepAgent\.env (or the data dir override).

# LLM provider: openrouter (default) | ollama | custom
# DEEPAGENT_LLM_PROVIDER=openrouter

# Required for OpenRouter / custom. Optional for Ollama.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model id (OpenRouter slug, Ollama tag, or custom provider id)
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_TEMPERATURE=0.3

# OpenRouter attribution headers (openrouter provider only)
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_SITE_NAME=deep-agent

# Base URL for ollama / custom (OpenAI-compatible, usually ends with /v1)
# Ollama default when unset: http://127.0.0.1:11434/v1
# DEEPAGENT_LLM_BASE_URL=http://127.0.0.1:11434/v1
# DEEPAGENT_LLM_BASE_URL=https://api.openai.com/v1

# Workspace (host path bind-mounted at /workspace in the microVM)
# DEEPAGENT_WORKDIR=./workspace
# Desktop default when unset: %USERPROFILE%\Documents\DeepAgent\workspace

# App data (SQLite, .env, logs, agents, .mcp.json)
# DEEPAGENT_DATA_DIR=./data
# Desktop default when unset: %APPDATA%\DeepAgent

# Packaged desktop sidecar flag (set by Tauri)
# DEEPAGENT_DESKTOP=1

# App-wide guest network: false → Network.none(), true → Network.public_only()
# DEEPAGENT_NETWORK_ACCESS=false

# Upstream DNS for the guest interceptor (comma-separated). Default: 1.1.1.1,8.8.8.8
# Set to empty or "host" to use microsandbox host auto-detect (often broken on Windows).
# DEEPAGENT_DNS_NAMESERVERS=1.1.1.1,8.8.8.8

# Guest image (default: python:3.12-slim from Docker Hub)
# DEEPAGENT_SANDBOX_IMAGE=python:3.12-slim
# Optional custom: build Dockerfile.sandbox, msb load, then set the tag here

# DEEPAGENT_SANDBOX_MEMORY=1024
# DEEPAGENT_SANDBOX_CPUS=2
# DEEPAGENT_SANDBOX_IDLE_TIMEOUT=300
# DEEPAGENT_SANDBOX_LOCK_WAIT=120
# DEEPAGENT_EXEC_TIMEOUT=120

# MCP servers (optional). Copy .mcp.json.example to .mcp.json, or set env vars.
# Desktop: prefer %APPDATA%\DeepAgent\.mcp.json (DEEPAGENT_MCP_CONFIG still overrides).
# DEEPAGENT_MCP_ENABLED=true
# IRESEARCHER_MCP_URL=https://iresearcher-mcp.elevatics.site/mcp
# IRESEARCHER_MCP_BEARER_TOKEN=your_token_here
