# Copy this file to .env and fill in your key.

# Required. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional. Any tool-calling-capable model id from https://openrouter.ai/models
# Examples: anthropic/claude-sonnet-4.5, openai/gpt-5, google/gemini-3-pro,
#           qwen/qwen3-max, deepseek/deepseek-v3.2
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Optional. Sampling temperature.
OPENROUTER_TEMPERATURE=0.3

# Optional. OpenRouter attribution headers (shows up in their dashboard/logs,
# and some free/rate-limited models require a Referer to be set at all).
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_SITE_NAME=deep-agent-bwrap

# Docker / compose (optional overrides for docker-compose.yml)
# DEEPAGENT_NETWORK_ACCESS=true
